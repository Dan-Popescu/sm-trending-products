# Production template: provide values outside git. Never use the Moto local
# profile for real evidence; its object data is ephemeral.
POSTGRES_USER=sm_trends
POSTGRES_DB=sm_trends
POSTGRES_PASSWORD=
# URL-encode the password; within Compose the database hostname is postgres.
DATABASE_URL=
PIPELINE_NAMESPACE=production
S3_BUCKET=
# Leave empty for AWS S3; set an HTTPS endpoint for a compatible production store.
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CREATE_BUCKET_ON_INIT=false

# User token with video.list for an explicitly authorized account.
TIKTOK_DISPLAY_ACCESS_TOKEN=
# Client token with approved research.adlib.basic and permitted intended use.
TIKTOK_CCL_ACCESS_TOKEN=

# Tune only after a representative benchmark. Compose overrides paths in its image.
COLLECTOR_BINARY=collector/target/debug/sm-collector
CACHE_DIR=.cache/objects
SPOOL_DIR=.cache/spool
CACHE_MAX_BYTES=2000000000
BATCH_SIZE=20
# Bounded planner admission, independently of the Rust-enforced source quotas.
SCHEDULER_REQUEST_BUDGET=500
COLLECTION_SCHEDULE_MINUTES=5
ASSESSMENT_SCHEDULE_MINUTES=15
WORKER_BATCH_SIZE=20
LEASE_SECONDS=180
COLLECTOR_TIMEOUT_SECONDS=90
MAX_ATTEMPTS=8
ANALYSIS_PRODUCT_BATCH_SIZE=100
ANALYSIS_MAX_ROWS_PER_BATCH=1000000
HISTORY_PARTITION_BUCKETS=64
POLARS_MAX_THREADS=2
RAYON_NUM_THREADS=2
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=512MB

# Default per-service limits are intentionally tunable; these are not capacity claims.
POSTGRES_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=768m
DAGSTER_WEBSERVER_MEMORY_LIMIT=768m
DAGSTER_DAEMON_MEMORY_LIMIT=1536m
DASHBOARD_MEMORY_LIMIT=768m
