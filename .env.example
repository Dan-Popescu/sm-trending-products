# Production template: provide values outside git. Never use the Moto local
# profile for real evidence; its object data is ephemeral.
POSTGRES_USER=sm_trends
POSTGRES_DB=sm_trends
POSTGRES_PASSWORD=
# Host-local release control only. This port is never bound to a public address.
POSTGRES_HOST_PORT=5432
# URL-encode the password; within Compose the database hostname is postgres.
DATABASE_URL=
PIPELINE_NAMESPACE=production
S3_BUCKET=
# Leave empty for AWS S3; set an HTTPS endpoint for a compatible production store.
S3_ENDPOINT_URL=
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CREATE_BUCKET_ON_INIT=false

# Production uses independent acquisition; standalone Python keeps legacy mode
# unless this is explicitly enabled. Pin releases by immutable registry digest.
ACQUISITION_ENABLED=true
PIPELINE_IMAGE=
CAPTURE_BLUE_IMAGE=
CAPTURE_GREEN_IMAGE=
ACQUISITION_PLANNER_IMAGE=
ACQUISITION_PLANNER_BLUE_IMAGE=
ACQUISITION_PLANNER_GREEN_IMAGE=
NORMALIZER_IMAGE=
ANALYTICS_IMAGE=
DASHBOARD_IMAGE=
# The release controller supplies a distinct identity for each runtime generation.
# Empty values use local-only defaults; production releases must replace them.
CAPTURE_BLUE_WORKER_ID=
CAPTURE_GREEN_WORKER_ID=
CAPTURE_STOP_GRACE_PERIOD=15m

# User token with video.list for an explicitly authorized account.
TIKTOK_DISPLAY_ACCESS_TOKEN=
# Client token with approved research.adlib.basic and permitted intended use.
TIKTOK_CCL_ACCESS_TOKEN=

# Tune only after a representative benchmark. Compose overrides paths in its image.
COLLECTOR_BINARY=collector/target/debug/sm-collector
CACHE_DIR=.cache/objects
SPOOL_DIR=.cache/spool
CAPTURE_SPOOL_MAX_BYTES=268435456
CACHE_MAX_BYTES=2000000000
BATCH_SIZE=20
# Bounded planner admission, independently of the Rust-enforced source quotas.
SCHEDULER_REQUEST_BUDGET=500
COLLECTION_SCHEDULE_MINUTES=5
ASSESSMENT_SCHEDULE_MINUTES=15
MAINTENANCE_SCHEDULE_MINUTES=15
MAINTENANCE_MAX_SECONDS=120
RETENTION_MAX_BATCHES=100
RETENTION_MAX_OBJECTS=10000
RETENTION_MAX_OPERATIONS=20000
COMPACTION_MAX_BATCHES=24
# Compacted read copies can use fewer, larger Parquet files; source files stay at 1,000 rows.
COMPACTION_TARGET_ROWS_PER_FILE=5000
WORKER_BATCH_SIZE=20
NORMALIZER_BATCH_SIZE=20
LEASE_SECONDS=180
COLLECTOR_TIMEOUT_SECONDS=90
MAX_ATTEMPTS=8
ANALYSIS_PRODUCT_BATCH_SIZE=100
ANALYSIS_MAX_ROWS_PER_BATCH=1000000
HISTORY_PARTITION_BUCKETS=64
HISTORY_TARGET_ROWS_PER_FILE=1000
POLARS_MAX_THREADS=2
RAYON_NUM_THREADS=2
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=512MB

# Default per-service limits are intentionally tunable; these are not capacity claims.
POSTGRES_MEMORY_LIMIT=1g
WORKER_MEMORY_LIMIT=768m
ACQUISITION_PLANNER_MEMORY_LIMIT=512m
NORMALIZER_MEMORY_LIMIT=768m
DAGSTER_WEBSERVER_MEMORY_LIMIT=768m
DAGSTER_DAEMON_MEMORY_LIMIT=1536m
DASHBOARD_MEMORY_LIMIT=768m
