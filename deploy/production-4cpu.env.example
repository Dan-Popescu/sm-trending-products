# Append these resource overrides to a PRIVATE runtime.env based on .env.example.
# Explicit single-host pilot profile: 4 vCPU / 16 GiB, with one overlap candidate.
# These ceilings are starting settings; source rate/catch-up qualification is separate.
COMPOSE_PROJECT_NAME=pilot
ACQUISITION_ENABLED=true
POSTGRES_MEMORY_LIMIT=2g
POSTGRES_CPUS=0.5
WORKER_MEMORY_LIMIT=768m
WORKER_CPUS=0.75
ACQUISITION_PLANNER_MEMORY_LIMIT=512m
ACQUISITION_PLANNER_CPUS=0.25
NORMALIZER_MEMORY_LIMIT=1g
NORMALIZER_CPUS=0.5
DAGSTER_WEBSERVER_MEMORY_LIMIT=768m
DAGSTER_WEBSERVER_CPUS=0.25
DAGSTER_DAEMON_MEMORY_LIMIT=1536m
DAGSTER_DAEMON_CPUS=0.5
DASHBOARD_MEMORY_LIMIT=768m
DASHBOARD_CPUS=0.25
CAPTURE_SPOOL_MAX_BYTES=268435456
POLARS_MAX_THREADS=2
RAYON_NUM_THREADS=2
DUCKDB_THREADS=2
DUCKDB_MEMORY_LIMIT=512MB
